# Configuración de fin de línea para diferentes tipos de archivos
* text=auto
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sql text eol=lf
*.txt text eol=lf

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Archivos de configuración específicos
package.json text eol=lf
package-lock.json text eol=lf
next.config.js text eol=lf
next.config.production.js text eol=lf
vercel.json text eol=lf
.gitignore text eol=lf

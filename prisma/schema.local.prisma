generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  password     String
  isActive     Boolean  @default(true)
  roleId       String
  companyId    String?
  resetToken   String?  // Token para restablecer contraseña
  resetTokenExpiry DateTime? // Fecha de expiración del token
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdJobs  Job[]    @relation("JobCreatedBy")
  assignedJobs Job[]    @relation("JobTechnician")
  company      Company? @relation(fields: [companyId], references: [id])
  role         Role     @relation(fields: [roleId], references: [id])
  payments     Payment[] // Pagos creados por el usuario
  quotes       Quote[]   // Cotizaciones creadas por el usuario
  cashTransactions CashTransaction[] // Transacciones de caja creadas por el usuario
  liquidationsAsTechnician Liquidation[] @relation("LiquidationTechnician")
  liquidationsAsCreator Liquidation[] @relation("LiquidationCreatedBy")
  reports         Report[] // Reportes generados por el usuario
  invoices        Invoice[] // Facturas creadas por el usuario
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  region    String?
  commune   String?
  rut       String?
  company   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
  quotes    Quote[]
  payments  Payment[]
}

model Company {
  id           String   @id @default(cuid())
  name         String
  displayName  String?  // Nombre para mostrar en documentos
  email        String?
  phone        String?
  address      String?
  rut          String?   // RUT de la empresa
  logo         String?   // Ruta del logo
  type         String?   // Tipo de empresa (AMESTICA, MULTIFUGAS, SERVIFUGAS)
  service      String?   // Descripción del servicio
  primaryColor String?   // Color primario
  secondaryColor String? // Color secundario
  accentColor  String?   // Color de acento
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobs         Job[]
  users        User[]
  liquidations Liquidation[]
  quotes       Quote[]
  reports      Report[]
  invoices     Invoice[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("PENDING")
  priority    String   @default("MEDIUM")
  startTime   DateTime?
  endTime     DateTime?
  scheduledAt DateTime?
  completedAt DateTime?
  price       Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clientId    String
  serviceId    String?
  companyId    String
  createdById  String
  assignedToId String?
  client      Client   @relation(fields: [clientId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])
  createdBy   User     @relation("JobCreatedBy", fields: [createdById], references: [id])
  technician  User?    @relation("JobTechnician", fields: [assignedToId], references: [id])
  payments    Payment[]
  quotes      Quote[]
}

model Payment {
  id          String   @id @default(cuid())
  amount      Float
  method      String
  status      String   @default("PENDING")
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobId       String
  clientId    String
  createdById String
  job         Job      @relation(fields: [jobId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model Quote {
  id          String   @id @default(cuid())
  title       String
  description String?
  amount      Float
  status      String   @default("PENDING")
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clientId    String
  companyId   String
  jobId       String?
  createdById String
  client      Client   @relation(fields: [clientId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])
  job         Job?     @relation(fields: [jobId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model CashTransaction {
  id          String   @id @default(cuid())
  type        String   // "INCOME" o "EXPENSE"
  amount      Float
  description String
  category    String?
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model Liquidation {
  id          String   @id @default(cuid())
  title       String
  description String?
  amount      Float
  status      String   @default("PENDING")
  period      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  technicianId String
  companyId   String
  createdById String
  technician  User     @relation("LiquidationTechnician", fields: [technicianId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])
  createdBy   User     @relation("LiquidationCreatedBy", fields: [createdById], references: [id])
}

model Report {
  id          String   @id @default(cuid())
  title       String
  type        String
  data        String?  // JSON data
  status      String   @default("GENERATED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String
  createdById String
  company     Company  @relation(fields: [companyId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model Invoice {
  id          String   @id @default(cuid())
  number      String
  amount      Float
  status      String   @default("PENDING")
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String
  createdById String
  company     Company  @relation(fields: [companyId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
}
# Variables de entorno para producción en Vercel
# Copia este archivo y configura las variables en Vercel Dashboard

# Base de datos PostgreSQL (OBLIGATORIO)
# IMPORTANTE: Reemplaza con tu URL de base de datos real
DATABASE_URL="postgresql://postgres.rwsqkirgxsxrpjepjhtr:amesticaportal@aws-1-us-east-2.pooler.supabase.com:6543/postgres"

# Configuración de entorno
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED=1
# NextAuth.js
NEXTAUTH_URL="https://sistema-web-administrativo-v1.vercel.app"
NEXTAUTH_SECRET="bb180c6364b8d19fc0a57626c2a623f60aedc883c5e5ada4e9908931b8fceb7e"

# Email Configuration (OPCIONAL - para notificaciones)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="tu-email@gmail.com"
EMAIL_SERVER_PASSWORD="tu-app-password"
EMAIL_FROM="tu-email@gmail.com"

# Cloudinary (OPCIONAL - para imágenes)
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# FormSubmit (OPCIONAL - para formularios)
FORMSUBMIT_ENDPOINT="https://formsubmit.co/tu-email@dominio.com"

# Web3Forms (OPCIONAL - alternativa a FormSubmit)
WEB3FORMS_ACCESS_KEY="tu-access-key"

# Configuración de Node.js para Vercel
NODE_OPTIONS="--max-old-space-size=4096"
NEXT_TELEMETRY_DISABLED=1
